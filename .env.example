OPENROUTER_API_KEY=

# Web UI basic auth (set at least one)
DASHBOARD_PASSWORD=
# DASHBOARD_PASSWORD_HASH=  # bcrypt, alternative to plaintext above
DASHBOARD_USER=admin

# Optional integrations
TELEGRAM_BOT_TOKEN=

# Avoid setting HERMES_INFERENCE_PROVIDER, HERMES_MODEL, or HERMES_INFERENCE_MODEL
# here — they override config.yaml on every boot and make the dashboard's model
# settings appear to "reset" on each redeploy. Configure the model in config.yaml.
